DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"
# "Войти через GetGrip" — GetGrip acting as an OAuth2 authorization server.
# GETGRIP_URL is GetGrip's own public API base.
# AUTH_GETGRIP_ID/SECRET are issued by GetGrip's oauth_client table for this app.
GETGRIP_URL="https://demo.getgrip.ru/api"
AUTH_GETGRIP_ID="wisely"
AUTH_GETGRIP_SECRET="replace-with-secret-issued-by-getgrip"
